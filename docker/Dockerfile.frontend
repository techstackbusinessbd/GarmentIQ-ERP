# -----------------------------------------------------------------------------
# Node.js 22 & Vite Development Dockerfile for React 19 + Tailwind v4
# -----------------------------------------------------------------------------
FROM node:22-alpine

WORKDIR /app

# Expose Vite dev server port
EXPOSE 5173

# Start Vite dev server with host flag for docker container access
CMD ["sh", "-c", "if [ -f package.json ]; then npm install && npm run dev -- --host 0.0.0.0; else tail -f /dev/null; fi"]

# -----------------------------------------------------------------------------
# Node.js 22 & Vite Development Dockerfile for React 19 + Tailwind v4
# -----------------------------------------------------------------------------
FROM node:22-alpine

WORKDIR /app

# Expose Vite dev server port
EXPOSE 5173

# [EN] Start Vite dev server instantly if node_modules exists, otherwise install dependencies first
# [BN] node_modules থাকলে সরাসরি Vite চালু করবে, না থাকলে প্রথমে ডিপেনডেন্সি ইনস্টল করবে
CMD ["sh", "-c", "if [ ! -d node_modules ] || [ -z \"$(ls -A node_modules 2>/dev/null)\" ]; then npm install; fi && npm run dev -- --host 0.0.0.0"]
